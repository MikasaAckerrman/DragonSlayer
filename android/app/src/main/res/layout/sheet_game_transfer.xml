<?xml version="1.0" encoding="utf-8"?>
<!--
	Bottom sheet offered when the user taps "Transfer game files".

	Two directions, and they are deliberately NOT symmetrical, so each card says
	what it does to the source: import COPIES (the folder is left alone, a failed
	run costs nothing), export MOVES (its purpose is to free the app directory, so
	leaving a second copy would defeat it). Spelling that out on the button is the
	only place the user will read it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="8dp"
	android:paddingTop="16dp"
	android:paddingBottom="24dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="4dp"
		android:text="@string/game_transfer_title"
		android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

	<TextView
		android:id="@+id/game_transfer_paths"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="16dp"
		android:textAppearance="@style/TextAppearance.Material3.BodySmall"
		tools:text="/storage/emulated/0/xash&#10;/storage/emulated/0/Android/data/su.xash.engine.test/files/xash" />

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/game_transfer_import"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="8dp"
		android:layout_marginBottom="8dp"
		android:clickable="true"
		android:focusable="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="14dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/game_transfer_import"
				android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="@string/game_transfer_import_summary"
				android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/game_transfer_export"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="8dp"
		android:clickable="true"
		android:focusable="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="14dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/game_transfer_export"
				android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="@string/game_transfer_export_summary"
				android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
